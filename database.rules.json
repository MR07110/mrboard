{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "rooms": {
      ".read": true,
      ".indexOn": ["isPublic", "createdBy", "createdAt", "isActive"],
      "$roomId": {
        ".write": true
      }
    },
    "mrboard": {
      "$roomId": {
        ".read": true,
        ".write": true,
        "elements": {
          ".indexOn": ["t", "u"]
        },
        "chat": {
          ".indexOn": ["tm", "u"]
        }
      }
    },
    "mrboard_final": {
      "$roomId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
